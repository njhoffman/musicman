/*
 * musicman menu: the source in the title, the cover beside the song's details and the menu's status
 * (player, state, volume, whether the song is in the library), and a grid of buttons. musicman sets the
 * cover, the status, the accent color (Spotify green or MPD amber), the grid size, and in submenus a
 * filter box per menu with -theme-str. Override anything through menu.rofiArgs, or replace the theme
 * with menu.theme.
 */

configuration {
    show-icons: false;
}

* {
    background:       #1b1e25;
    background-dark:  #15171d;
    background-alt:   #262b35;
    background-hover: #303644;
    foreground:       #c8ccd4;
    muted:            #5c6370;
    accent:           #61afef;
    font:             "FiraCode Nerd Font 10";
    background-color: transparent;
    text-color:       @foreground;
}

window {
    location:         center;
    anchor:           center;
    width:            1040px;
    border:           2px solid;
    border-color:     @accent;
    border-radius:    14px;
    background-color: @background;
    background-image: linear-gradient(to bottom, #1f232b, #16181e);
}

mainbox {
    orientation: vertical;
    children:    [ "inputbar", "info", "listview" ];
    padding:     18px;
    spacing:     14px;
}

inputbar {
    children: [ "prompt" ];
    spacing:  0;
}

prompt {
    font:       "FiraCode Nerd Font Bold 12";
    text-color: @accent;
}

/* shown in submenus, where typing filters the buttons */
textbox-sep {
    expand:     false;
    content:    "   ";
    text-color: @muted;
}

entry {
    placeholder:       "type to filter";
    placeholder-color: @muted;
    cursor-color:      @accent;
}

/* The cover, the song's details, and the status right-aligned beside them */
info {
    expand:           false;
    orientation:      horizontal;
    children:         [ "icon-cover", "message", "textbox-status" ];
    spacing:          18px;
    padding:          12px 16px;
    border:           0 0 0 3px solid;
    border-color:     @accent;
    border-radius:    10px;
    background-color: @background-dark;
}

/* musicman sets filename to the song's cover; without one the square stays empty */
icon-cover {
    expand:         false;
    size:           132px;
    vertical-align: 0.5;
    border-radius:  8px;
}

message {
    expand:         true;
    vertical-align: 0.5;
}

textbox-status {
    expand:           false;
    content:          " ";
    markup:           true;
    horizontal-align: 1;
    vertical-align:   0.5;
    text-color:       @muted;
}

textbox {
    text-color: @foreground;
    markup:     true;
}

listview {
    columns:      9;
    lines:        2;
    flow:         horizontal;
    fixed-height: true;
    cycle:        true;
    scrollbar:    false;
    layout:       vertical;
    spacing:      8px;
}

scrollbar {
    handle-color: @accent;
    handle-width: 4px;
}

element {
    orientation:      vertical;
    padding:          6px 4px;
    border:           2px solid;
    border-color:     transparent;
    border-radius:    10px;
    background-color: @background-alt;
    cursor:           pointer;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    text-color:       inherit;
    cursor:           inherit;
}

/* highlighted: the song has the tag, the mode is on */
element normal.active,
element alternate.active   { text-color: @accent; }
/* urgent marks buttons that do not apply in submenus (the main menu fades them with markup) */
element normal.urgent,
element alternate.urgent   { text-color: @muted; }
/* the selected button keeps its colored icon, framed in accent */
element selected.normal,
element selected.active,
element selected.urgent    { background-color: @background-hover; border-color: @accent; }
element selected.active    { text-color: @accent; }
element selected.urgent    { text-color: @muted; }
