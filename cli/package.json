{
  "name": "musicman-cli",
  "description": "mp3 metadata manager",
  "main": "lib/cli.js",
  "scripts": {
    "dev": "nodemon --config ./nodemon.json lib/cli.js",
    "start": "node lib/cli.js",
    "start:stats": "node lib/cli.js stats",
    "daemon": "systemctl --user start musicman-notify",
    "daemon:stop": "systemctl --user stop musicman-notify",
    "daemon:status": "systemctl --user status musicman-notify",
    "daemon:install": "node scripts/install-daemon.js",
    "profile": "ndb --prof pnpm start",
    "lint": "esw lib test --color",
    "lint:fix": "pnpm lint --fix",
    "lint:watch": "pnpm lint --watch --clear",
    "test": "NODE_ENV=test mocha",
    "test:watch": "NODE_ENV=test chokidar 'test/**/*.js' 'lib/**/*.js' -c 'node_modules/.bin/mocha'",
    "test:coverage": "NODE_ENV=test nyc mocha",
    "config:check": "node scripts/check-config.js"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "babel-eslint": "^10.1.0",
    "chai": "^4.5.0",
    "chokidar-cli": "^2.1.0",
    "copy-dir": "^1.3.0",
    "eslint": "^7.22.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-config-standard": "^16.0.3",
    "eslint-plugin-babel": "^5.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^3.3.1",
    "eslint-plugin-promise": "^4.3.1",
    "eslint-watch": "^7.0.0",
    "mocha": "^8.3.2",
    "nodemon": "^2.0.22",
    "nyc": "^15.1.0",
    "prettier": "^2.8.8",
    "proxyquire": "^2.1.3",
    "rimraf": "^3.0.2",
    "sinon": "^10.0.1",
    "sinon-chai": "^3.7.0"
  },
  "dependencies": {
    "bluebird": "^3.7.2",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "diff": "^9.0.0",
    "flat": "^6.0.1",
    "glob": "^13.0.6",
    "js-yaml": "^5.5.0",
    "lodash": "^4.18.1",
    "mp3-duration": "^1.1.0",
    "musicman-common": "workspace:*",
    "node-id3": "^0.2.9",
    "pretty-error": "^4.0.0",
    "prompt-confirm": "2.0.4",
    "string-width": "^8.3.0"
  },
  "version": "1.2.0",
  "engines": {
    "node": ">=24"
  }
}
