{
  "name": "musicman",
  "version": "1.62.0",
  "description": "Music Manager",
  "main": "index.js",
  "scripts": {
    "release": "commit-and-tag-version",
    "test": "pnpm --filter musicman-cli test && node --test 'scripts/*.test.js'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"cli/lib/**/*.js\" \"cli/test/**/*.js\" \"cli/scripts/**/*.js\" \"common/config/**/*.js\" \"common/mpd/**/*.js\" eslint.config.js \"scripts/**/*.js\" \"!cli/test/data/**\"",
    "format:check": "prettier --check \"cli/lib/**/*.js\" \"cli/test/**/*.js\" \"cli/scripts/**/*.js\" \"common/config/**/*.js\" \"common/mpd/**/*.js\" eslint.config.js \"scripts/**/*.js\" \"!cli/test/data/**\"",
    "prepare": "husky",
    "publish:local": "scripts/publish-local.sh"
  },
  "author": "Nick Hoffman",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "commit-and-tag-version": "^13.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  }
}
