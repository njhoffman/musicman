{
  "name": "musicman",
  "version": "1.18.0",
  "description": "Music Manager",
  "main": "index.js",
  "scripts": {
    "release": "standard-version",
    "todos": "leasot -x 'cli/lib/**/*.js' 'cli/test/**/*.js' 'cli/config/**/*.js' 'server/lib/**/*.js' 'server/test/**/*.js'",
    "test": "pnpm --filter musicman-cli test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"cli/lib/**/*.js\" \"cli/test/**/*.js\" \"cli/scripts/**/*.js\" \"common/config/**/*.js\" \"common/mpd/**/*.js\" eslint.config.js \"!cli/test/data/**\"",
    "format:check": "prettier --check \"cli/lib/**/*.js\" \"cli/test/**/*.js\" \"cli/scripts/**/*.js\" \"common/config/**/*.js\" \"common/mpd/**/*.js\" eslint.config.js \"!cli/test/data/**\""
  },
  "author": "Nick Hoffman",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "commitlint-config-gitmoji": "^2.3.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "leasot": "^14.4.0",
    "prettier": "^3.9.10",
    "standard-version": "^9.5.0"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  }
}
